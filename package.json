{
  "name": "multi-image-compress-and-edit",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "generate-routes": "bunx @tanstack/router-cli generate",
    "lint": "bunx eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "bunx tsc --noEmit",
    "clean": "rm -rf dist node_modules .bun",
    "fresh": "bun run clean && bun install",
    "analyze": "bunx --bun vite build --config vite.config.analyze.ts",
    "analyze:serve": "bun run analyze && bunx --bun vite preview --outDir dist",
    "test:build": "bun run build && bun run preview",
    "bundle:stats": "bunx --bun vite build --config vite.config.analyze.ts && echo 'Bundle analysis complete! Check dist/bundle-analysis.html'"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-router": "1.141.2",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "emoji-picker-react": "4.16.1",
    "jszip": "3.10.1",
    "lucide-react": "0.561.0",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "14.3.8",
    "react-easy-crop": "5.5.6",
    "react-hook-form": "7.68.0",
    "react-image-crop": "11.0.10",
    "simple-icons": "16.1.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "uuid": "13.0.0",
    "zod": "4.1.13",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.141.2",
    "@tanstack/router-devtools": "1.141.2",
    "@tanstack/router-vite-plugin": "1.141.2",
    "@types/jszip": "3.4.1",
    "@types/node": "25.0.1",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "^10.4",
    "babel-plugin-transform-remove-console": "6.9.4",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "postcss": "8.5.6",
    "rollup-plugin-visualizer": "6.0.5",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "7.2.7"
  },
  "trustedDependencies": [
    "@tanstack/router-cli"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
